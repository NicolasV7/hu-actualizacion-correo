# Variables de ambiente del microservicio contact-update-service.
# Spring Boot las lee del entorno del proceso (exportarlas en la terminal o configurarlas en el IDE/plataforma).
# Para la demo local basta con SPRING_PROFILES_ACTIVE=local: activa los stubs y no requiere URLs.

PORT=8080
SPRING_PROFILES_ACTIVE=local

# Modo de integración: http (APIs corporativas reales) o stub (datos sintéticos; lo fija el perfil local/test).
INTEGRATION_MODE=http
INTEGRATION_CONNECT_TIMEOUT=PT2S
INTEGRATION_READ_TIMEOUT=PT5S

# Obligatorias con INTEGRATION_MODE=http. Las credenciales nunca se versionan.
CUSTOMER_DATA_BASE_URL=https://integrationhub.example.com/customer-data/v1
CUSTOMER_DATA_API_KEY=
IDENTITY_BASE_URL=https://integrationhub.example.com/identity/v1
IDENTITY_API_KEY=
MESSAGING_BASE_URL=https://integrationhub.example.com/messaging/v1
MESSAGING_API_KEY=

# Política del código de verificación (INC-003).
VERIFICATION_CODE_TTL=PT5M
VERIFICATION_MAX_ATTEMPTS=3
VERIFICATION_RESEND_COOLDOWN=PT60S

# Solo perfiles local y test: único código aceptado por el stub.
STUB_VERIFICATION_CODE=123456

# Formato de logs: ecs (estructurado, por defecto). El perfil local usa texto legible.
LOG_FORMAT=ecs
